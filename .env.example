# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/quantara"

# Port the NestJS server listens on
PORT=4000

# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Groq API key for AI chat (https://console.groq.com)
GROQ_API_KEY="your-groq-api-key"

# Redis connection string (use rediss:// for Upstash/TLS in production)
REDIS_URL="redis://localhost:6379"

# Comma-separated list of allowed CORS origins (frontend URL(s))
FRONTEND_URL="http://localhost:5173"
